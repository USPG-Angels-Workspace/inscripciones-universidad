@model IEnumerable<Curso>
@{
    ViewData["Title"] = "Cursos";
}

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-slate-900">Cursos</h1>
    <a asp-action="Create" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">
        Nuevo curso
    </a>
</div>

<div class="overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50">
            <tr>
                <th class="px-4 py-3 text-left font-semibold text-slate-600">@Html.DisplayNameFor(m => m.Codigo)</th>
                <th class="px-4 py-3 text-left font-semibold text-slate-600">@Html.DisplayNameFor(m => m.Nombre)</th>
                <th class="px-4 py-3 text-left font-semibold text-slate-600">Carrera</th>
                <th class="px-4 py-3 text-left font-semibold text-slate-600">@Html.DisplayNameFor(m => m.Creditos)</th>
                <th class="px-4 py-3 text-left font-semibold text-slate-600">@Html.DisplayNameFor(m => m.CupoMaximo)</th>
                <th class="px-4 py-3 text-right font-semibold text-slate-600">Acciones</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            @foreach (var item in Model)
            {
                <tr class="hover:bg-slate-50">
                    <td class="px-4 py-3 font-medium text-slate-700">@item.Codigo</td>
                    <td class="px-4 py-3">@item.Nombre</td>
                    <td class="px-4 py-3">@item.Carrera?.Nombre</td>
                    <td class="px-4 py-3">@item.Creditos</td>
                    <td class="px-4 py-3">@item.CupoMaximo</td>
                    <td class="px-4 py-3 text-right space-x-3">
                        <a asp-action="Details" asp-route-id="@item.Id" class="text-indigo-600 hover:underline">Ver</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="text-amber-600 hover:underline">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="text-rose-600 hover:underline">Eliminar</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="px-4 py-6 text-center text-slate-400">No hay cursos registrados.</td></tr>
            }
        </tbody>
    </table>
</div>
