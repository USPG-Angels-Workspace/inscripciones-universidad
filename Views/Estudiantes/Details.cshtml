@model Estudiante
@{
    ViewData["Title"] = "Detalle de estudiante";
}

<h1 class="text-2xl font-bold text-slate-900 mb-6">@Model.NombreCompleto</h1>

<div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm max-w-xl">
    <dl class="divide-y divide-slate-100">
        <div class="py-3 grid grid-cols-3 gap-4">
            <dt class="text-slate-500">@Html.DisplayNameFor(m => m.Carne)</dt>
            <dd class="col-span-2 text-slate-800">@Model.Carne</dd>
        </div>
        <div class="py-3 grid grid-cols-3 gap-4">
            <dt class="text-slate-500">@Html.DisplayNameFor(m => m.Email)</dt>
            <dd class="col-span-2 text-slate-800">@Model.Email</dd>
        </div>
        <div class="py-3 grid grid-cols-3 gap-4">
            <dt class="text-slate-500">Carrera</dt>
            <dd class="col-span-2 text-slate-800">@Model.Carrera?.Nombre</dd>
        </div>
    </dl>
</div>

<h2 class="text-lg font-semibold text-slate-900 mt-8 mb-3">Inscripciones</h2>
<div class="overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50">
            <tr>
                <th class="px-4 py-3 text-left font-semibold text-slate-600">Curso</th>
                <th class="px-4 py-3 text-left font-semibold text-slate-600">Período</th>
                <th class="px-4 py-3 text-left font-semibold text-slate-600">Estado</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            @foreach (var i in Model.Inscripciones)
            {
                <tr>
                    <td class="px-4 py-3">@i.Curso?.Nombre</td>
                    <td class="px-4 py-3">@i.Periodo?.Nombre</td>
                    <td class="px-4 py-3">@i.Estado</td>
                </tr>
            }
            @if (!Model.Inscripciones.Any())
            {
                <tr><td colspan="3" class="px-4 py-6 text-center text-slate-400">Sin inscripciones registradas.</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-6 flex gap-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="rounded-md bg-amber-500 px-4 py-2 text-sm font-medium text-white hover:bg-amber-600">Editar</a>
    <a asp-action="Index" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Volver</a>
</div>
