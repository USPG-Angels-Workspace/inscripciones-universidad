@model Estudiante
@{
    ViewData["Title"] = "Nuevo estudiante";
}

<h1 class="text-2xl font-bold text-slate-900 mb-6">Nuevo estudiante</h1>

<div class="max-w-lg rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
    <form asp-action="Create" method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600"></div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="Nombres" class="block text-sm font-medium text-slate-700"></label>
                <input asp-for="Nombres" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500" />
                <span asp-validation-for="Nombres" class="text-sm text-rose-600"></span>
            </div>
            <div>
                <label asp-for="Apellidos" class="block text-sm font-medium text-slate-700"></label>
                <input asp-for="Apellidos" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500" />
                <span asp-validation-for="Apellidos" class="text-sm text-rose-600"></span>
            </div>
        </div>

        <div>
            <label asp-for="Carne" class="block text-sm font-medium text-slate-700"></label>
            <input asp-for="Carne" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500" />
            <span asp-validation-for="Carne" class="text-sm text-rose-600"></span>
        </div>

        <div>
            <label asp-for="Email" class="block text-sm font-medium text-slate-700"></label>
            <input asp-for="Email" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500" />
            <span asp-validation-for="Email" class="text-sm text-rose-600"></span>
        </div>

        <div>
            <label asp-for="CarreraId" class="block text-sm font-medium text-slate-700">Carrera</label>
            <select asp-for="CarreraId" asp-items="ViewBag.CarreraId" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500">
                <option value="">-- Seleccione --</option>
            </select>
            <span asp-validation-for="CarreraId" class="text-sm text-rose-600"></span>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">Guardar</button>
            <a asp-action="Index" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
