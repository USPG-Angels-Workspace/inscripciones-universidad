@model Inscripcion
@{
    ViewData["Title"] = "Nueva inscripción";
}

<h1 class="text-2xl font-bold text-slate-900 mb-6">Nueva inscripción</h1>

<div class="max-w-lg rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
    <form asp-action="Create" method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600"></div>

        <div>
            <label asp-for="EstudianteId" class="block text-sm font-medium text-slate-700">Estudiante</label>
            <select asp-for="EstudianteId" asp-items="ViewBag.EstudianteId" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500">
                <option value="">-- Seleccione --</option>
            </select>
            <span asp-validation-for="EstudianteId" class="text-sm text-rose-600"></span>
        </div>

        <div>
            <label asp-for="CursoId" class="block text-sm font-medium text-slate-700">Curso</label>
            <select asp-for="CursoId" asp-items="ViewBag.CursoId" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500">
                <option value="">-- Seleccione --</option>
            </select>
            <span asp-validation-for="CursoId" class="text-sm text-rose-600"></span>
        </div>

        <div>
            <label asp-for="PeriodoId" class="block text-sm font-medium text-slate-700">Período</label>
            <select asp-for="PeriodoId" asp-items="ViewBag.PeriodoId" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500">
                <option value="">-- Seleccione --</option>
            </select>
            <span asp-validation-for="PeriodoId" class="text-sm text-rose-600"></span>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">Guardar</button>
            <a asp-action="Index" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
