@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center py-10">
    <h1 class="text-3xl font-bold text-slate-900">Sistema de Inscripciones Universitarias</h1>
    <p class="mt-3 text-slate-600">Administra carreras, cursos, períodos académicos, estudiantes e inscripciones.</p>
</div>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <a asp-controller="Carreras" asp-action="Index" class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm hover:shadow-md hover:border-indigo-300 transition">
        <h2 class="font-semibold text-indigo-700">Carreras</h2>
        <p class="mt-1 text-sm text-slate-500">Gestiona las carreras de la universidad.</p>
    </a>
    <a asp-controller="Cursos" asp-action="Index" class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm hover:shadow-md hover:border-indigo-300 transition">
        <h2 class="font-semibold text-indigo-700">Cursos</h2>
        <p class="mt-1 text-sm text-slate-500">Cursos disponibles por carrera, con cupo máximo.</p>
    </a>
    <a asp-controller="Periodos" asp-action="Index" class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm hover:shadow-md hover:border-indigo-300 transition">
        <h2 class="font-semibold text-indigo-700">Períodos</h2>
        <p class="mt-1 text-sm text-slate-500">Períodos académicos en los que se abren inscripciones.</p>
    </a>
    <a asp-controller="Estudiantes" asp-action="Index" class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm hover:shadow-md hover:border-indigo-300 transition">
        <h2 class="font-semibold text-indigo-700">Estudiantes</h2>
        <p class="mt-1 text-sm text-slate-500">Registro de estudiantes matriculados.</p>
    </a>
    <a asp-controller="Inscripciones" asp-action="Index" class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm hover:shadow-md hover:border-indigo-300 transition">
        <h2 class="font-semibold text-indigo-700">Inscripciones</h2>
        <p class="mt-1 text-sm text-slate-500">Inscribe estudiantes a cursos respetando el cupo disponible.</p>
    </a>
</div>
