@model Periodo
@{
    ViewData["Title"] = "Editar período";
}

<h1 class="text-2xl font-bold text-slate-900 mb-6">Editar período académico</h1>

<div class="max-w-lg rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
    <form asp-action="Edit" method="post" class="space-y-4">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600"></div>

        <div>
            <label asp-for="Nombre" class="block text-sm font-medium text-slate-700"></label>
            <input asp-for="Nombre" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500" />
            <span asp-validation-for="Nombre" class="text-sm text-rose-600"></span>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="FechaInicio" class="block text-sm font-medium text-slate-700"></label>
                <input asp-for="FechaInicio" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500" />
                <span asp-validation-for="FechaInicio" class="text-sm text-rose-600"></span>
            </div>
            <div>
                <label asp-for="FechaFin" class="block text-sm font-medium text-slate-700"></label>
                <input asp-for="FechaFin" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500" />
                <span asp-validation-for="FechaFin" class="text-sm text-rose-600"></span>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <input asp-for="Activo" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
            <label asp-for="Activo" class="text-sm font-medium text-slate-700"></label>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">Guardar</button>
            <a asp-action="Index" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
